# ---------------------------------------------------------------------------
# Next.js application configuration
# Copy to .env.local and adjust. Never commit a filled in file.
#
# Only variables prefixed with NEXT_PUBLIC_ reach the browser. Everything below
# stays on the server.
# ---------------------------------------------------------------------------

NODE_ENV=development
# The public address people type. No trailing slash: the sign in callback
# is built from it, and production refuses to start on a bad value.
APP_URL=http://localhost:3000
LOG_LEVEL=info

# --- Database --------------------------------------------------------------
# memory   : in-process, no persistence. Development only.
# postgres : Supabase PostgreSQL or any other PostgreSQL server.
DATABASE_DRIVER=memory
DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# --- Authentication --------------------------------------------------------
# supabase : Google login through Supabase Auth.
# dev      : signed local cookie, refuses to run in production.
AUTH_PROVIDER=dev
# Generate with: openssl rand -hex 32
AUTH_SESSION_SECRET=development-session-secret-change-me

# Supabase project settings. The service role key must never reach the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth is configured inside the Supabase dashboard, not here.
# The application requests the login scopes only, never Sheets or Drive scopes.

# --- Object storage --------------------------------------------------------
# supabase : Supabase Storage. local : filesystem, development only.
STORAGE_DRIVER=local
STORAGE_BUCKET=datainsight
STORAGE_LOCAL_DIR=./.runtime/storage

# --- Python analysis service ----------------------------------------------
PYTHON_SERVICE_URL=http://127.0.0.1:8000
# Must match PYTHON_SERVICE_SECRET in python-service/.env
PYTHON_SERVICE_SECRET=
INTERNAL_SERVICE_ID=datainsight-web
PYTHON_SERVICE_TIMEOUT_MS=180000

# --- Limits ----------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=20
MAX_REQUEST_BODY_MB=25

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT_MAX=120
RATE_LIMIT_UPLOAD_MAX=10
RATE_LIMIT_RUN_MAX=20
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_DOWNLOAD_MAX=60

# --- Background jobs -------------------------------------------------------
# Disable on a serverless deployment and run an external worker instead.
JOB_WORKER_ENABLED=true
JOB_POLL_INTERVAL_MS=1000

# --- Retention -------------------------------------------------------------
REPORT_RETENTION_DAYS=365
